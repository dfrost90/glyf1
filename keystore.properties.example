# Copy this file to `keystore.properties` (gitignored) and fill in your
# release keystore details, then run `./gradlew assembleRelease`.
#
# Generate a keystore first:
#   keytool -genkey -v -keystore glyf1-release.jks \
#     -keyalg RSA -keysize 2048 -validity 10000 -alias glyf1
#
# storeFile is resolved relative to the project root.
storeFile=glyf1-release.jks
storePassword=CHANGE_ME
keyAlias=glyf1
keyPassword=CHANGE_ME
